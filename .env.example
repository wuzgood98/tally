# Postgres connection string (POSTGRES_URL, which Vercel's database
# integrations set, works too). Leave unset to use the built-in PGlite database
# in .data/pglite, which migrates and seeds itself on first run.
# DATABASE_URL=postgres://tally:password@localhost:5432/tally

# The certificate authority (PEM text) your database host signs with, when
# it isn't one Node already trusts. Supabase: Project Settings > Database >
# SSL Configuration > Download certificate. The connection is then encrypted
# and fully verified; any sslmode in DATABASE_URL is ignored. On one line,
# write each line break as \n.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Signs session cookies. Required in production; any long random string.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# The public URL the app is served from.
BETTER_AUTH_URL=http://localhost:3000

# Name shown in the app. Defaults to the demo retailer, Akwaaba Mall.
# TALLY_COMPANY_NAME=

# Lists the demo accounts on the sign-in page. Defaults to on for PGlite and
# off for a real Postgres database.
# TALLY_DEMO=false
